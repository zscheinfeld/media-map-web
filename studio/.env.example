# Copy to `.env` and fill in. These are read by sanity.config.ts / sanity.cli.ts
# (Studio) and by the import script.

# Your Sanity project ID (from sanity.io/manage, or run `npx sanity init` to create one).
SANITY_STUDIO_PROJECT_ID=

# Dataset name. "production" is the conventional default.
SANITY_STUDIO_DATASET=production

# --- Import script only (studio/scripts/import-from-sheet.ts) ---
# A write-enabled API token (sanity.io/manage -> API -> Tokens -> Editor/Deploy).
# Only needed to run `npm run import`; the Studio UI uses interactive login instead.
SANITY_AUTH_TOKEN=

# The import script falls back to the SANITY_STUDIO_* vars above for project/dataset,
# but you can override them here if you want the import to target a different dataset.
# SANITY_PROJECT_ID=
# SANITY_DATASET=

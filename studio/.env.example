# Copy to `.env` and fill in. These are read by sanity.config.ts / sanity.cli.ts
# (Studio) and by the import script.

# Your Sanity project ID (from sanity.io/manage, or run `npx sanity init` to create one).
SANITY_STUDIO_PROJECT_ID=

# Dataset name. "production" is the conventional default.
SANITY_STUDIO_DATASET=production

# Published "valuations" Google Sheet (Publish to web -> CSV), keyed by slug x year
# — the SAME sheet the public app reads via VITE_VALUATIONS_CSV_URL. The Map Editor
# sizes planets from this so they match production and resize as the year is
# scrubbed. Unset -> the editor falls back to manual/legacy valuations.
SANITY_STUDIO_VALUATIONS_CSV_URL=

# --- Maintenance scripts only (import / publish-drafts / republish-all) ---
# A write-enabled API token (sanity.io/manage -> API -> Tokens -> Editor).
# Only needed for those scripts; the Studio UI uses interactive login instead.
# NOTE: the Sanity CLI auto-uses SANITY_AUTH_TOKEN for ALL auth, so an Editor
# token here would otherwise mask your own login and block `sanity deploy`
# (deploy needs admin/deploy grants). The `deploy` npm script blanks it for that
# reason, so `npm run deploy` always runs as your interactive (admin) login.
SANITY_AUTH_TOKEN=

# The import script falls back to the SANITY_STUDIO_* vars above for project/dataset,
# but you can override them here if you want the import to target a different dataset.
# SANITY_PROJECT_ID=
# SANITY_DATASET=

# Template only — DO NOT put real secrets here (this file is committed).
# Real values go in jobs/.env (gitignored). Yours are already there and working.

FMP_API_KEY=

SANITY_PROJECT_ID=haxcsjkn
SANITY_DATASET=production
SANITY_AUTH_TOKEN=

# Valuation sheet WRITE mode (optional locally; set as GitHub secrets for the Action).
# When both are set, ingest-valuations writes straight into the sheet (preserving
# manual values) instead of emitting market_cap.csv.
# SHEET_ID = the id from the sheet's EDIT url (.../d/<THIS>/edit), not the /d/e/2PACX… publish link.
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# SHEET_TAB=market_cap   # optional; defaults to the first tab
